.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #f5f6f7;
}

.chat-list {
  flex: 1;
  height: 0;
  padding: 22rpx 24rpx;
  box-sizing: border-box;
}

.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 24rpx;
}
.msg-row.user { flex-direction: row-reverse; }

.avatar {
  width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0;
  background: #0f7b7e; color: #ffffff;
  display: flex; align-items: center; justify-content: center;
  font-size: 22rpx; font-weight: 800; letter-spacing: 1rpx;
  box-shadow: 0 4rpx 10rpx rgba(15, 123, 126, .18);
}

.msg-main {
  max-width: 78%;
  display: flex;
  flex-direction: column;
}
.msg-row.user .msg-main { align-items: flex-end; }

.bubble {
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 27rpx;
  line-height: 1.7;
  white-space: pre-wrap;
  word-break: break-all;
}
.msg-row.agent .bubble {
  background: #ffffff;
  border: 2rpx solid #e0e4e6;
  border-top-left-radius: 6rpx;
  color: #2b3a3c;
  box-shadow: 0 6rpx 16rpx rgba(43, 58, 60, .05);
}
.msg-row.user .bubble {
  background: #0f7b7e;
  border-top-right-radius: 6rpx;
  color: #ffffff;
}

.typing {
  display: flex; align-items: center; gap: 8rpx;
  padding: 20rpx 24rpx;
  background: #ffffff; border: 2rpx solid #e0e4e6; border-radius: 20rpx;
  border-top-left-radius: 6rpx;
}
.dot {
  width: 10rpx; height: 10rpx; border-radius: 50%;
  background: #9fb6b6;
  animation: blink 1.2s infinite;
}
.dot:nth-child(2) { animation-delay: .2s; }
.dot:nth-child(3) { animation-delay: .4s; }
@keyframes blink {
  0%, 80%, 100% { opacity: .25; }
  40% { opacity: 1; }
}
.typing-text { margin-left: 6rpx; color: #758286; font-size: 22rpx; }

.article-list {
  width: 100%;
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.article {
  display: flex; align-items: center; gap: 12rpx;
  padding: 20rpx 22rpx;
  background: #ffffff;
  border: 2rpx solid #e0e4e6;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(43, 58, 60, .04);
}
.article-main { flex: 1; min-width: 0; }
.article-title { font-size: 26rpx; font-weight: 700; color: #2b3a3c; }
.article-meta { margin-top: 6rpx; font-size: 21rpx; color: #758286; }
.article-arrow { color: #b9c2c0; font-size: 32rpx; }

.report-action {
  margin-top: 14rpx;
  padding: 14rpx 24rpx;
  border: 2rpx solid #0f7b7e;
  border-radius: 999rpx;
  color: #0f7b7e;
  font-size: 24rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, .6);
}

.quick-row {
  flex-shrink: 0;
  white-space: nowrap;
  padding: 8rpx 24rpx 14rpx;
  box-sizing: border-box;
}
.quick-chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #cfe0e0;
  color: #0a5f62;
  font-size: 23rpx;
}

.input-bar {
  flex-shrink: 0;
  display: flex; align-items: center; gap: 14rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  border-top: 2rpx solid #e8edec;
}
.chat-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  background: #f5f6f7;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #2b3a3c;
}
.ph { color: #a8b1b3; }
.send-btn {
  width: 110rpx; height: 76rpx; line-height: 76rpx;
  text-align: center;
  border-radius: 999rpx;
  background: #e3e8e8;
  color: #9aa6a6;
  font-size: 26rpx;
  font-weight: 700;
}
.send-btn.on { background: #0f7b7e; color: #ffffff; }

.list-bottom { height: 20rpx; }
