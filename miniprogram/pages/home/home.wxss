.home-page { padding: 10rpx 0 48rpx; }
.welcome-wrap { padding: 20rpx 32rpx 22rpx; }
.eyebrow { display: flex; align-items: center; gap: 10rpx; color: #0a5f62; font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; }
.eyebrow::before { content: ""; width: 20rpx; height: 8rpx; border-radius: 999rpx; background: #0f7b7e; }
.greeting { margin-top: 18rpx; color: #2b3a3c; font-size: 40rpx; font-weight: 800; letter-spacing: 1rpx; font-family: "STSong", "Songti SC", serif; }
.welcome-sub { margin-top: 8rpx; color: #758286; font-size: 23rpx; }

.hero-panel { position: relative; overflow: hidden; margin: 0 24rpx 26rpx; border-radius: 24rpx; background: #0a5f62; color: #ffffff; box-shadow: 0 10rpx 26rpx rgba(10, 95, 98, .22); }
.reporter-hero { min-height: 270rpx; padding: 30rpx 30rpx 26rpx; box-sizing: border-box; background: linear-gradient(125deg, #0a5f62, #0f7b7e); }
.hero-content { position: relative; z-index: 2; }
.hero-kicker { display: inline-block; padding: 6rpx 14rpx; border: 1rpx solid rgba(255,255,255,.38); border-radius: 999rpx; color: #e1f1ef; font-size: 20rpx; letter-spacing: 2rpx; }
.hero-title { margin-top: 18rpx; color: #ffffff; font-size: 38rpx; font-weight: 800; letter-spacing: 2rpx; font-family: "STSong", "Songti SC", serif; }
.hero-copy { margin-top: 8rpx; color: rgba(255,255,255,.82); font-size: 22rpx; }
.hero-button { width: 226rpx; height: 66rpx; margin: 20rpx 0 0; padding: 0 22rpx; display: flex; align-items: center; justify-content: space-between; color: #2b3a3c; background: #f4d58d; border: 2rpx solid #2b3a3c; border-radius: 999rpx; font-size: 24rpx; font-weight: 700; box-shadow: 4rpx 4rpx 0 rgba(43,58,60,.6); }
.hero-arrow { font-size: 34rpx; line-height: 1; }
.hero-orbit { position: absolute; z-index: 1; border: 2rpx dashed rgba(255,255,255,.2); border-radius: 50%; pointer-events: none; }
.orbit-one { width: 260rpx; height: 260rpx; top: -92rpx; right: -70rpx; }
.orbit-two { width: 180rpx; height: 180rpx; top: -50rpx; right: -30rpx; border-color: rgba(244,213,141,.45); }

.section-row { display: flex; align-items: baseline; gap: 12rpx; margin: 26rpx 30rpx 14rpx; }
.section-heading { color: #2b3a3c; font-size: 30rpx; font-weight: 800; letter-spacing: 1rpx; font-family: "STSong", "Songti SC", serif; }
.section-link { margin-left: auto; color: #0f7b7e; font-size: 22rpx; font-weight: 600; }
.section-link text { font-size: 30rpx; vertical-align: -2rpx; }
.section-note { color: #86909c; font-size: 20rpx; }
.stats-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 12rpx; margin: 0 24rpx; }
.stat-card { position: relative; overflow: hidden; min-height: 130rpx; padding: 20rpx 16rpx; box-sizing: border-box; background: #ffffff; border: 2rpx solid #e0e4e6; border-radius: 18rpx; box-shadow: 0 5rpx 18rpx rgba(43,58,60,.05); }
.stat-card::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 7rpx; background: #0f7b7e; }
.stat-card.tone-butter::before { background: #d9a53f; }
.stat-card.tone-sky::before { background: #5aa9b0; }
.stat-card.tone-blush::before { background: #d98a98; }
.stat-value { margin-top: 4rpx; color: #0f7b7e; font-size: 38rpx; font-weight: 800; font-family: "STSong", "Songti SC", serif; font-variant-numeric: tabular-nums; }
.tone-butter .stat-value { color: #a9761b; }
.tone-sky .stat-value { color: #367b82; }
.tone-blush .stat-value { color: #a55061; }
.stat-label { margin-top: 4rpx; color: #758286; font-size: 21rpx; }
.stat-loading { height: 130rpx; border: 2rpx solid #e0e4e6; border-radius: 18rpx; background: #ffffff; }

.category-head { margin-top: 30rpx; }
.category-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 12rpx; margin: 0 24rpx; }
.category-tile { min-height: 148rpx; position: relative; display: flex; flex-direction: column; justify-content: center; gap: 12rpx; padding: 18rpx; box-sizing: border-box; background: #ffffff; border: 2rpx solid #e0e4e6; border-radius: 18rpx; box-shadow: 0 5rpx 18rpx rgba(43,58,60,.05); }
.category-icon { width: 48rpx; height: 48rpx; display: block; flex: 0 0 48rpx; border-radius: 14rpx; background-color: #d7ecec; background-repeat: no-repeat; background-position: center; background-size: 31rpx 31rpx; }
.category-name { overflow: hidden; color: #2b3a3c; font-size: 22rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.category-arrow { position: absolute; right: 14rpx; top: 18rpx; color: #a0abad; font-size: 28rpx; }
.tone-butter .category-icon { background-color: #fbf0d8; }
.tone-sky .category-icon { background-color: #bcdfe6; }
.tone-blush .category-icon { background-color: #fae9ec; }
.tone-paper .category-icon { background-color: #edf1f2; }
