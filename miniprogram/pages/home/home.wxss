.category-empty { margin: 0 24rpx; padding: 30rpx; border: 2rpx dashed #c6cad0; border-radius: 18rpx; color: #758286; background: rgba(255,255,255,.7); font-size: 22rpx; text-align: center; }

.recent-head { margin-top: 32rpx; }
.ticket-list { display: flex; flex-direction: column; gap: 12rpx; margin: 0 24rpx; }
.ticket-card { display: flex; overflow: hidden; background: #ffffff; border: 2rpx solid #e0e4e6; border-radius: 16rpx; box-shadow: 0 5rpx 18rpx rgba(43,58,60,.05); }
.ticket-side { width: 8rpx; flex: 0 0 8rpx; background: #d9a53f; }
.ticket-side.side-urgent { background: #d98a98; }
.ticket-main { flex: 1; min-width: 0; padding: 18rpx 20rpx; }
.ticket-top { display: flex; align-items: center; gap: 12rpx; }
.ticket-title { flex: 1; min-width: 0; overflow: hidden; color: #2b3a3c; font-size: 25rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.status-pill { flex-shrink: 0; padding: 5rpx 12rpx; border-radius: 999rpx; font-size: 19rpx; font-weight: 600; }
.ticket-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 10rpx; }
.ticket-type { padding: 4rpx 12rpx; border-radius: 999rpx; color: #5b7074; background: #edf1f2; font-size: 19rpx; }
.ticket-time { margin-left: auto; overflow: hidden; color: #86909c; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.empty-card { display: flex; flex-direction: column; align-items: center; margin: 0 24rpx; padding: 34rpx 28rpx; background: #ffffff; border: 2rpx dashed #c6cad0; border-radius: 20rpx; text-align: center; }
.empty-mark { width: 62rpx; height: 62rpx; display: flex; align-items: center; justify-content: center; color: #0f7b7e; background: #d7ecec; border-radius: 50%; font-family: "STKaiti", "KaiTi", serif; font-size: 29rpx; }
.empty-title { margin-top: 14rpx; color: #2b3a3c; font-size: 25rpx; font-weight: 700; }
.empty-copy { margin-top: 8rpx; color: #758286; font-size: 21rpx; line-height: 1.5; }
.empty-action { margin-top: 18rpx; padding: 8rpx 18rpx; color: #0a5f62; background: #d7ecec; border-radius: 999rpx; font-size: 21rpx; font-weight: 700; }

.worker-hero { padding: 30rpx; background: linear-gradient(125deg, #0a5f62, #0f7b7e); }
.worker-hero-content { position: relative; z-index: 2; }
.worker-name { margin-top: 18rpx; color: #ffffff; font-size: 35rpx; font-weight: 800; }
.worker-name text { margin-left: 8rpx; color: #f4d58d; font-size: 21rpx; font-weight: 600; }
.worker-sub { margin-top: 8rpx; color: rgba(255,255,255,.85); font-size: 21rpx; }
.worker-divider { margin: 0 8rpx; color: rgba(255,255,255,.45); }
.load-row { display: flex; justify-content: space-between; margin-top: 20rpx; color: rgba(255,255,255,.85); font-size: 20rpx; }
.load-track { height: 10rpx; margin-top: 8rpx; overflow: hidden; border-radius: 999rpx; background: rgba(255,255,255,.22); }
.load-value { height: 100%; border-radius: inherit; background: #f4d58d; }
.worker-fallback { margin: 0 24rpx; padding: 20rpx; color: #758286; background: #ffffff; border: 1rpx dashed #c6cad0; border-radius: 16rpx; font-size: 22rpx; }
.worker-stats { margin-top: 0; }
.load-error { display: flex; align-items: center; justify-content: space-between; margin: 22rpx 24rpx; padding: 16rpx 20rpx; color: #8a3b4a; background: #fae9ec; border: 1rpx dashed #edc0c8; border-radius: 12rpx; font-size: 21rpx; }
.load-error view { padding: 8rpx 14rpx; color: #8a3b4a; background: #ffffff; border-radius: 999rpx; font-weight: 700; }

/* 智能报修助手入口 */
.agent-entry {
  display: flex; align-items: center; gap: 20rpx;
  margin: 28rpx 24rpx 4rpx; padding: 28rpx 26rpx;
  background: linear-gradient(120deg, #eef8f8 0%, #f7fbfb 55%, #fdf7ea 100%);
  border: 2rpx solid #cfe4e4;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 20rpx rgba(15, 123, 126, .07);
}
.agent-entry:active { transform: scale(.99); }
.agent-mark {
  width: 84rpx; height: 84rpx; border-radius: 26rpx; flex-shrink: 0;
  background: #0f7b7e; color: #ffffff;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 800; letter-spacing: 1rpx;
  box-shadow: 0 6rpx 14rpx rgba(15, 123, 126, .18);
}
.agent-copy { flex: 1; min-width: 0; }
.agent-title { font-size: 30rpx; font-weight: 800; color: #2b3a3c; letter-spacing: 1rpx; }
.agent-desc { margin-top: 6rpx; font-size: 22rpx; color: #758286; line-height: 1.5; }
.agent-arrow { color: #0f7b7e; font-size: 34rpx; flex-shrink: 0; }
