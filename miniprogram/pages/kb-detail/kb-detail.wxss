.page { padding: 30rpx 24rpx; }
.head { margin-bottom: 24rpx; }
.title { font-size: 38rpx; font-weight: 800; color: #2b3a3c; line-height: 1.45; font-family: "STSong", "Songti SC", serif; }
.meta { margin-top: 12rpx; font-size: 22rpx; color: #86909c; }
.card {
  background: #fff; border-radius: 18rpx; padding: 30rpx; border: 1rpx solid #e3e7e8;
  box-shadow: 0 6rpx 18rpx rgba(43, 58, 60, .04);
}
.content { font-size: 28rpx; line-height: 1.85; color: #33464a; white-space: pre-wrap; }
/* rich-text 内部是内联样式，这里只兜底字体与断行 */
.md { display: block; font-size: 15px; line-height: 1.8; color: #33464a; word-break: break-word; }
.tip {
  margin-top: 24rpx; padding: 20rpx 24rpx; border-radius: 14rpx;
  background: #fbf6e8; color: #7a6535; font-size: 24rpx; line-height: 1.6;
}
.actions { display: flex; gap: 16rpx; margin-top: 24rpx; }
.btn {
  flex: 1; margin: 0; padding: 0; height: 84rpx; line-height: 84rpx;
  border-radius: 16rpx; font-size: 26rpx; font-weight: 600;
}
.btn::after { border: none; }
.btn.ghost { background: #ffffff; color: #0f7b7e; border: 2rpx solid #bcdcdc; }
.btn.primary { background: #0f7b7e; color: #ffffff; }
.feedback-done {
  margin-top: 24rpx; padding: 22rpx 24rpx; border-radius: 14rpx;
  background: #e8f4f1; color: #0a5f62; font-size: 24rpx; text-align: center;
}
.bottom-space { height: 40rpx; }
