.page { padding-bottom: 40rpx; }
.hello { padding: 26rpx 32rpx 18rpx; }
.hello-title { color: #2b3a3c; font-size: 38rpx; font-weight: 800; letter-spacing: 1rpx; font-family: "STSong", "Songti SC", serif; }
.hello-sub { font-size: 24rpx; color: #758286; margin-top: 9rpx; line-height: 1.55; }
.hello::after { content: ""; display: block; width: 84rpx; margin-top: 16rpx; border-bottom: 3rpx dashed #0f7b7e; }
.item { margin-bottom: 34rpx; }
.item:last-child { margin-bottom: 8rpx; }
.count { font-weight: 400; color: #86909c; font-size: 22rpx; margin-left: auto; }
.optional { font-weight: 400; color: #758286; font-size: 22rpx; margin-left: 12rpx; }
.pick-text { flex: 1; }
.map-clear { color: #0a5f62; font-size: 24rpx; font-weight: 600; padding: 8rpx 0 8rpx 20rpx; }
.pick-addr { margin-top: 10rpx; font-size: 22rpx; color: #758286; line-height: 1.5; }

.urgency { display: flex; gap: 16rpx; }
.u-card { flex: 1; background: #f7f8f8; border: 2rpx solid transparent; border-radius: 16rpx; padding: 22rpx 24rpx; transition: all 0.2s ease; }
.u-card.u-on { background: #d7ecec; border-color: #0f7b7e; }
.u-card.u-on-urgent { background: #fae9ec; border-color: #d98a98; }
.u-dot { width: 14rpx; height: 14rpx; border-radius: 50%; margin-bottom: 14rpx; }
.u-dot-normal { background: #0f7b7e; }
.u-dot-urgent { background: #c66575; }
.u-name { font-size: 28rpx; font-weight: 700; color: #2b3a3c; }
.u-name-urgent { color: #8a3b4a; }
.u-desc { font-size: 21rpx; color: #758286; margin-top: 6rpx; }

.desc { width: 100%; box-sizing: border-box; background: #f7f8f8; border: 1rpx dashed #c6cad0; border-radius: 14rpx; padding: 22rpx; min-height: 210rpx; font-size: 28rpx; line-height: 1.65; }
.ph { color: #86909c; }
.loc-detail { margin-top: 16rpx; }
.loc-input { width: 100%; box-sizing: border-box; background: #f7f8f8; border: 1rpx dashed #c6cad0; border-radius: 14rpx; padding: 20rpx 22rpx; height: 84rpx; font-size: 28rpx; }
.loc-tip { margin-top: 10rpx; font-size: 22rpx; color: #758286; line-height: 1.5; }
.campus-address { margin-top: 8rpx; font-size: 22rpx; color: #0a5f62; line-height: 1.5; }
.footer { padding: 10rpx 24rpx; }
.submit { width: 100%; }

.service-head { padding: 28rpx 30rpx 18rpx; }
.service-kicker { color: #0a5f62; font-size: 21rpx; font-weight: 700; letter-spacing: 2rpx; }
.service-title { margin-top: 10rpx; color: #2b3a3c; font-family: "STSong", "Songti SC", serif; font-size: 42rpx; font-weight: 800; letter-spacing: 2rpx; }
.service-sub { margin-top: 8rpx; color: #758286; font-size: 23rpx; line-height: 1.55; }
.service-switch { display: flex; gap: 8rpx; margin-top: 22rpx; padding: 8rpx; background: #e9ebed; border: 2rpx dashed #c6cad0; border-radius: 20rpx; }
.service-tab { flex: 1; min-width: 0; height: 74rpx; display: flex; align-items: center; justify-content: center; gap: 10rpx; color: #5b6e70; border: 2rpx solid transparent; border-radius: 14rpx; font-size: 25rpx; font-weight: 600; transition: background-color .18s ease, color .18s ease, box-shadow .18s ease; }
.service-tab.active { background: #0f7b7e; border-color: #2b3a3c; color: #fff; box-shadow: 3rpx 3rpx 0 #2b3a3c; }
.service-tab-mark { width: 32rpx; height: 32rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: rgba(15, 123, 126, .12); color: #0a5f62; font-size: 24rpx; line-height: 1; }
.service-tab.active .service-tab-mark { background: rgba(255, 255, 255, .2); color: #fff; }
.service-count { min-width: 30rpx; height: 30rpx; padding: 0 6rpx; display: flex; align-items: center; justify-content: center; border-radius: 999rpx; background: #f4d58d; color: #5b4517; font-size: 19rpx; line-height: 1; }
.service-panel { padding-top: 2rpx; }
.orders-panel { padding-bottom: 8rpx; }
.orders-heading { display: flex; align-items: center; justify-content: space-between; margin: 10rpx 30rpx 14rpx; padding: 20rpx 22rpx; background: #fff; border: 2rpx solid #e0e4e6; border-radius: 20rpx; box-shadow: 0 6rpx 22rpx rgba(43, 58, 60, .05); }
.orders-title { color: #2b3a3c; font-size: 29rpx; font-weight: 800; letter-spacing: 1rpx; }
.orders-sub { margin-top: 6rpx; color: #758286; font-size: 21rpx; }
.orders-total { display: flex; align-items: baseline; gap: 6rpx; color: #0f7b7e; font-family: "STSong", "Songti SC", serif; font-size: 37rpx; font-weight: 800; }
.orders-total-label { color: #758286; font-family: "PingFang SC", "Microsoft YaHei", sans-serif; font-size: 20rpx; font-weight: 500; }
.order-tabs { box-sizing: border-box; width: 100%; padding: 4rpx 24rpx 14rpx; white-space: nowrap; }
.order-tab { display: inline-flex; align-items: center; justify-content: center; margin-right: 10rpx; padding: 12rpx 23rpx; border: 2rpx solid #c6cad0; border-radius: 999rpx; background: #fff; color: #5b6e70; font-size: 23rpx; }
.order-tab.on { border-color: #2b3a3c; background: #2b3a3c; color: #fff; font-weight: 700; box-shadow: 3rpx 3rpx 0 #0f7b7e; }
.order-card { display: flex; align-items: stretch; gap: 0; padding: 0; overflow: hidden; }
.order-spine { width: 8rpx; flex-shrink: 0; background: #bcdfe6; }
.order-spine-urgent { background: #d98a98; }
.order-body { flex: 1; min-width: 0; padding: 22rpx 20rpx; }
.order-top { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; }
.order-number { min-width: 0; overflow: hidden; color: #5b6e70; font-size: 22rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; letter-spacing: 1rpx; }
.order-location { margin: 13rpx 0 12rpx; color: #2b3a3c; font-size: 28rpx; font-weight: 700; line-height: 1.4; }
.order-meta { display: flex; align-items: center; gap: 8rpx; }
.order-chip { flex-shrink: 0; padding: 6rpx 13rpx; border-radius: 999rpx; background: #edf1f2; color: #5b7074; font-size: 19rpx; }
.chip-urgent { background: #fae9ec; color: #8a3b4a; }
.order-time { margin-left: auto; color: #86909c; font-size: 19rpx; white-space: nowrap; }
.order-arrow { display: flex; align-items: center; padding: 0 18rpx 0 4rpx; color: #86909c; font-size: 36rpx; }
.orders-loading, .orders-error { color: #758286; font-size: 24rpx; text-align: center; }
.orders-error { display: flex; align-items: center; justify-content: center; gap: 18rpx; color: #8a3b4a; }
.retry-link { color: #0f7b7e; font-weight: 700; }
.orders-empty { display: flex; flex-direction: column; align-items: center; padding: 52rpx 24rpx 46rpx; text-align: center; }
.empty-mark { width: 82rpx; height: 82rpx; display: flex; align-items: center; justify-content: center; border: 2rpx dashed #0f7b7e; border-radius: 50%; background: #e7f1ec; color: #0a5f62; font-family: "STSong", "Songti SC", serif; font-size: 34rpx; font-weight: 800; }
.empty-title { margin-top: 16rpx; color: #2b3a3c; font-size: 27rpx; font-weight: 700; }
.empty-copy { margin-top: 8rpx; color: #758286; font-size: 22rpx; line-height: 1.6; }
.empty-action { margin-top: 22rpx; padding: 13rpx 22rpx; border: 2rpx solid #0f7b7e; border-radius: 999rpx; color: #0a5f62; font-size: 22rpx; font-weight: 700; }
.orders-more, .orders-end { padding: 18rpx 0 10rpx; color: #86909c; font-size: 20rpx; text-align: center; }
