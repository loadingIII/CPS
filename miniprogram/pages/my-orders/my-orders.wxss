.tabs {
  white-space: nowrap;
  background: rgba(245, 246, 247, 0.96);
  padding: 18rpx 20rpx 6rpx;
  position: sticky;
  top: 0;
  z-index: 10;
  border-bottom: 2rpx dashed #c6cad0;
}
.tab { display: inline-block; padding: 12rpx 28rpx; margin: 0 8rpx 12rpx 0; border-radius: 999rpx; font-size: 25rpx; color: #5b6e70; background: #ffffff; border: 2rpx solid #c6cad0; }
.tab.on { background: #2b3a3c; border-color: #2b3a3c; color: #f5f6f7; font-weight: 700; box-shadow: 3rpx 3rpx 0 #0f7b7e; }

.order { display: flex; padding: 0; overflow: hidden; }
.spine { width: 8rpx; background: #c6cad0; flex-shrink: 0; }
.spine-urgent { background: #d98a98; }
.body { flex: 1; padding: 24rpx 26rpx; }
.row1 { display: flex; justify-content: space-between; align-items: center; }
.orderNo { font-size: 25rpx; font-weight: 700; color: #5b6e70; letter-spacing: 1rpx; }
.loc { margin: 16rpx 0 14rpx; font-size: 30rpx; font-weight: 700; color: #2b3a3c; }
.row2 { display: flex; align-items: center; }
.chip { font-size: 21rpx; color: #5b6e70; background: #f5f6f7; padding: 6rpx 16rpx; border-radius: 999rpx; margin-right: 10rpx; }
.chip-urgent { color: #8a3b4a; background: #fae9ec; }
.time { margin-left: auto; color: #86909c; font-size: 21rpx; }
