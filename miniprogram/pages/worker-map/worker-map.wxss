.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.map { width: 100%; height: 46vh; }

.legend {
  display: flex;
  align-items: center;
  gap: 30rpx;
  margin: 16rpx 24rpx 0;
  padding: 16rpx 24rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 24rpx;
  color: #5C6E74;
}
.dot { width: 20rpx; height: 20rpx; border-radius: 50%; }
.dot-mine { background: #0E4A54; }
.dot-grab { background: #D96A3B; }
.legend-count { margin-left: auto; color: #97A6AB; font-size: 22rpx; }

.olist { flex: 1; overflow: hidden; }

.order { display: flex; padding: 0; overflow: hidden; }
.spine { width: 8rpx; flex-shrink: 0; }
.spine-mine { background: #0E4A54; }
.spine-grab { background: #D96A3B; }
.body { flex: 1; padding: 24rpx 26rpx; }
.row1 { display: flex; justify-content: space-between; align-items: center; }
.orderNo { font-size: 25rpx; font-weight: 600; color: #5C6E74; letter-spacing: 1rpx; }
.loc { margin: 14rpx 0 12rpx; font-size: 30rpx; font-weight: 600; }
.row2 { display: flex; align-items: center; }
.chip {
  font-size: 21rpx; color: #5C6E74;
  background: #F3F5F4;
  padding: 6rpx 16rpx; border-radius: 8rpx;
  margin-right: 10rpx;
}
