.page { padding: 24rpx; }
.tabs { display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx; }
.tab {
  padding: 10rpx 30rpx; border-radius: 999rpx; font-size: 26rpx; color: #5b6e70;
  background: #f5f6f7; border: 1rpx solid #d8dee0;
}
.tab.on { color: #fff; background: #0f7b7e; border-color: #0f7b7e; }
.read-all { margin-left: auto; font-size: 24rpx; color: #0f7b7e; }

.list { display: flex; flex-direction: column; gap: 18rpx; }
.card {
  position: relative; background: #fff; border-radius: 18rpx; padding: 24rpx;
  border: 1rpx solid #e3e7e8; box-shadow: 0 6rpx 18rpx rgba(43, 58, 60, .04);
}
.notice.read { opacity: .62; }
.notice-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10rpx; }
.type { font-size: 24rpx; color: #0f7b7e; font-weight: 600; }
.time { font-size: 22rpx; color: #86909c; }
.content { font-size: 27rpx; line-height: 1.6; color: #2b3a3c; }
.dot {
  position: absolute; top: 22rpx; right: 22rpx; width: 14rpx; height: 14rpx;
  border-radius: 50%; background: #d96a3b;
}

.empty { text-align: center; padding: 120rpx 40rpx; color: #86909c; }
.empty-mark {
  width: 96rpx; height: 96rpx; margin: 0 auto 20rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  background: #f0f4f4; color: #0f7b7e; font-family: "STSong", serif; font-size: 36rpx;
}
.empty-title { font-size: 28rpx; color: #5b6e70; margin-bottom: 10rpx; }
.empty-copy { font-size: 23rpx; line-height: 1.6; }
.bottom-space { height: 40rpx; }
