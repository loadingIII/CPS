<view class="page">
  <view class="card">
    <view class="title">这次维修服务您满意吗</view>
    <view class="stars">
      <text class="star {{rating >= n ? 'on' : ''}}" wx:for="{{[1,2,3,4,5]}}" wx:key="*this"
            data-n="{{item}}" bindtap="setRating">★</text>
    </view>
    <view class="hint">{{hints[rating - 1] || '点击星星评分'}}</view>
    <view class="tag-title">哪些地方做得好？（可多选）</view>
    <view class="tag-row">
      <text wx:for="{{tags}}" wx:key="*this" data-tag="{{item}}" bindtap="toggleTag"
            class="tag {{picked.indexOf(item) >= 0 ? 'tag-on' : ''}}">{{item}}</text>
    </view>
    <textarea class="desc" maxlength="500" value="{{content}}" bindinput="onContent"
              placeholder-class="ph" placeholder="说点什么吧（选填），例如：师傅很快修好了" />
  </view>
  <view class="footer">
    <button class="btn-primary submit" bindtap="onSubmit">提交评价</button>
  </view>
</view>
