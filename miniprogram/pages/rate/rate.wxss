.page { padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }
.title {
  text-align: center; font-size: 34rpx; font-weight: 700;
  margin: 26rpx 0 30rpx; letter-spacing: 2rpx;
}
.stars { text-align: center; margin: 20rpx 0; }
.star {
  font-size: 84rpx; color: #E1E7E6;
  margin: 0 18rpx; transition: transform 0.15s ease;
}
.star.on { color: #F2B33D; transform: scale(1.05); }
.hint {
  text-align: center; color: #97A6AB;
  font-size: 25rpx; margin-bottom: 36rpx; letter-spacing: 2rpx;
}
.desc {
  width: 100%; box-sizing: border-box;
  background: #F6F8F7; border-radius: 14rpx;
  padding: 22rpx; min-height: 190rpx;
  font-size: 28rpx; line-height: 1.65;
}
.ph { color: #B8C4C7; }
.footer { padding: 10rpx 24rpx; }
.submit { width: 100%; }
