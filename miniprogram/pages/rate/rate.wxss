.page { padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }
.title { text-align: center; font-size: 34rpx; font-weight: 800; color: #2b3a3c; margin: 26rpx 0 30rpx; letter-spacing: 1rpx; font-family: "STSong", "Songti SC", serif; }
.stars { text-align: center; margin: 20rpx 0; }
.star { font-size: 84rpx; color: #e0e4e6; margin: 0 18rpx; transition: transform 0.15s ease; }
.star.on { color: #b98527; transform: scale(1.05); }
.hint { text-align: center; color: #758286; font-size: 25rpx; margin-bottom: 36rpx; letter-spacing: 1rpx; }
.tag-title { font-size: 25rpx; color: #758286; margin-bottom: 16rpx; }
.tag-row { display: flex; flex-wrap: wrap; gap: 16rpx; margin-bottom: 30rpx; }
.tag {
  padding: 10rpx 26rpx; border-radius: 999rpx; font-size: 25rpx;
  color: #5b6e70; background: #f7f8f8; border: 1rpx solid #d8dee0;
}
.tag-on { color: #fff; background: #0f7b7e; border-color: #0f7b7e; }
.desc { width: 100%; box-sizing: border-box; background: #f7f8f8; border: 1rpx dashed #c6cad0; border-radius: 14rpx; padding: 22rpx; min-height: 190rpx; font-size: 28rpx; line-height: 1.65; }
.ph { color: #86909c; }
.footer { padding: 10rpx 24rpx; }
.submit { width: 100%; }
