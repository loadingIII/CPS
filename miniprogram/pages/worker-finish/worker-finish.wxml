<view class="page">
  <view class="card">
    <view class="field-label">维修说明 <text class="optional">10-500 字，必填</text></view>
    <textarea class="desc" maxlength="500" value="{{summary}}" bindinput="onSummary"
              placeholder-class="ph" placeholder="故障原因、处理方式，例如：更换启动电容后恢复正常" />
    <view class="field-label" style="margin-top: 30rpx">完工照片 <text class="optional">1-3 张，必传</text></view>
    <view class="imgs">
      <view class="img-box" wx:for="{{images}}" wx:key="*this">
        <image class="img" src="{{BASE}}{{item}}" mode="aspectFill" />
        <view class="del" data-idx="{{index}}" catchtap="deleteImage">×</view>
      </view>
      <view class="img-add" wx:if="{{images.length < 3}}" bindtap="chooseImage">
        <view class="icon-camera"></view>
        <view class="add-text">拍照</view>
      </view>
    </view>

    <view class="field-label" style="margin-top: 30rpx">
      更换配件 <text class="optional">选填，如启动电容 × 1</text>
    </view>
    <view class="part-row" wx:for="{{parts}}" wx:key="index">
      <input class="part-name" value="{{item.name}}" data-idx="{{index}}" bindinput="onPartName"
             placeholder="配件名称" placeholder-class="ph" />
      <input class="part-qty" type="number" value="{{item.qty}}" data-idx="{{index}}" bindinput="onPartQty"
             placeholder="数量" placeholder-class="ph" />
      <view class="part-del" data-idx="{{index}}" catchtap="removePart">×</view>
    </view>
    <view class="part-add" bindtap="addPart">+ 添加配件</view>
  </view>
  <view class="footer">
    <button class="btn-primary submit" bindtap="onSubmit">确认完工</button>
  </view>
</view>
