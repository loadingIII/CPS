.page { padding-bottom: calc(60rpx + env(safe-area-inset-bottom)); }
.field-label { font-size: 27rpx; font-weight: 600; margin-bottom: 16rpx; display: flex; align-items: center; }
.optional { font-weight: 400; color: #758286; font-size: 22rpx; margin-left: 12rpx; }
.desc { width: 100%; box-sizing: border-box; background: #f7f8f8; border: 1rpx dashed #c6cad0; border-radius: 14rpx; padding: 22rpx; min-height: 220rpx; font-size: 28rpx; line-height: 1.65; }
.ph { color: #86909c; }
.part-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.part-name {
  flex: 1; background: #f7f8f8; border: 1rpx dashed #c6cad0; border-radius: 12rpx;
  padding: 16rpx 18rpx; font-size: 26rpx;
}
.part-qty {
  width: 130rpx; text-align: center; background: #f7f8f8; border: 1rpx dashed #c6cad0;
  border-radius: 12rpx; padding: 16rpx 10rpx; font-size: 26rpx;
}
.part-del { width: 48rpx; text-align: center; color: #b9767e; font-size: 36rpx; }
.part-add {
  display: inline-block; margin-top: 6rpx; padding: 10rpx 24rpx; border-radius: 999rpx;
  border: 1rpx dashed #0f7b7e; color: #0f7b7e; font-size: 24rpx;
}
.img { width: 100%; height: 100%; border-radius: 16rpx; }
.footer { padding: 10rpx 24rpx; }
.submit { width: 100%; }
