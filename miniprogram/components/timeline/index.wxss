.tl { padding-left: 6rpx; }
.item { display: flex; }
.left { display: flex; flex-direction: column; align-items: center; width: 36rpx; }
.dot {
  width: 18rpx; height: 18rpx; border-radius: 50%;
  background: #C4D0D0; margin-top: 10rpx; flex-shrink: 0;
}
.dot-active {
  background: #0E4A54;
  box-shadow: 0 0 0 8rpx #E7F0F0;
}
.line { width: 3rpx; flex: 1; background: #E8EDEC; min-height: 56rpx; }
.right { flex: 1; padding: 0 0 34rpx 20rpx; }
.action { font-size: 28rpx; font-weight: 600; }
.op { font-size: 22rpx; color: #97A6AB; margin-top: 6rpx; }
.remark {
  margin-top: 12rpx; background: #F6F8F7; border-radius: 12rpx;
  padding: 14rpx 18rpx; font-size: 24rpx; color: #5C6E74; line-height: 1.5;
}
