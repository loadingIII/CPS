.bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background: rgba(255, 255, 255, 0.97);
  backdrop-filter: blur(16rpx);
  border-top: 2rpx dashed #c6cad0;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}
.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  padding: 14rpx 0 10rpx;
}
.item > view:first-child { width: 44rpx; height: 44rpx; }

/* Feather 描线图标：灰色默认态，青绿选中态 */
