# ============================================================
# 校园报修系统 · 本地环境变量示例
# 复制为 .env 后按需填写；.env 不要提交到版本库
#   复制：cp .env.example .env
# ============================================================

# ---------- 数据库 ----------
DB_URL=jdbc:mysql://localhost:3306/campus_repair?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=

# ---------- JWT ----------
# 占位值，生产环境请换成随机 32 字节以上字符串
JWT_SECRET=change-me-to-a-32-byte-secret-key-0123456789
JWT_EXPIRE_HOURS=168

# ---------- 智能助手总开关 ----------
# true 且 AI_API_KEY 非空时才启用 Spring AI + 向量检索；
# 否则自动回落到关键词问答，保证无密钥也能跑通演示。
AGENT_ENABLED=true

# ---------- 大模型（OpenAI 兼容端点） ----------
# 写到 /v1 即可（不带也能识别），后端与入库脚本都会归一化
# 示例：https://dashscope.aliyuncs.com/compatible-mode/v1
#       https://api.siliconflow.cn/v1
#       https://your-gateway.example.com/v1
AI_BASE_URL=
AI_API_KEY=
AI_CHAT_MODEL=
# 向量模型可单独一套端点/密钥（如对话走 DeepSeek、embedding 走阿里云百炼）
# 一旦填了 AI_EMBEDDING_BASE_URL，就必须同时填 AI_EMBEDDING_API_KEY（两家 key 不通用）
# 全部留空则沿用上面的 AI_BASE_URL / AI_API_KEY
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSIONS=1024
AI_TEMPERATURE=0.3
AI_TIMEOUT_SECONDS=90

# ---------- ChromaDB ----------
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=campus_repair_kb
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database

# ---------- RAG 参数 ----------
RAG_TOP_K=4
RAG_SIMILARITY_THRESHOLD=0.35
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_MAX_CONTEXT_CHARS=3000
RAG_HISTORY_TURNS=6
